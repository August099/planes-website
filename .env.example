# Variables de entorno de Ventas Aeronáuticas (solo nombres; los valores van en .env.local y en
# Vercel). Ver docs/PAGOS.md para las de pagos y facturación por ambiente.

# --- Base de datos (Prisma)
# Conexión directa: la usan las migraciones (prisma.config.ts lee .env).
DATABASE_URL=
# Conexión de la app en tiempo de ejecución (en Vercel, el pooler de Supabase).
RUNTIME_DATABASE_URL=

# --- Sitio
NEXT_PUBLIC_SITE_URL=
NEXTAUTH_URL=

# --- Auth.js (lib/auth.ts lee GOOGLE_CLIENT_ID/SECRET; si faltan, Auth.js usa AUTH_GOOGLE_ID/SECRET)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# --- Supabase (storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mails (Resend)
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# --- Mapas (opcional; sin clave, Stadia autoriza por dominio)
NEXT_PUBLIC_STADIA_API_KEY=

# --- VA-92 · Mercado Pago
# Access token del servidor (de prueba o de producción; el código no asume cuál).
MP_ACCESS_TOKEN=
# Solo si hace falta en el cliente (Checkout Pro redirige y no la necesita).
MP_PUBLIC_KEY=
# Clave secreta de los webhooks (Tus integraciones › Webhooks). Sin ella, el webhook rechaza todo.
MP_WEBHOOK_SECRET=
# URL base para back_urls (local: http://localhost:3000; Preview: la URL del preview).
APP_URL=
# Opcional: URL completa del webhook para el notification_url de las preferencias. Si falta, se
# usa APP_URL + /api/webhooks/mercadopago.
MP_NOTIFICATION_URL=

# --- VA-92 · Facturación (TusFacturasAPP)
# true/false. En false los pagos funcionan y las facturas quedan pendientes.
BILLING_ENABLED=
TUSFACTURAS_APIKEY=
TUSFACTURAS_APITOKEN=
TUSFACTURAS_USERTOKEN=
TUSFACTURAS_PUNTO_VENTA=
