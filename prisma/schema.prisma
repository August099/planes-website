// VA-150: saldo de publicaciones por lote (de dónde salió cada crédito). User.*ListingsBalance queda
// como total (se actualiza en la misma transacción). Orden de consumo en lib/balances.ts:
// suscripción vigente → LAUNCH → PACK del más viejo al más nuevo (LEGACY y ADMIN, junto con LAUNCH).
enum CreditSource {
  LAUNCH
  PACK
  ADMIN
  // Saldo que ya existía antes de VA-150 (no se sabe de qué compra salió): no se revierte.
  LEGACY
}

model CreditLot {
  id         String           @id @default(cuid())
  userId     String
  kind       ListingKind
  source     CreditSource
  // PACK: la compra que lo dio.
  purchaseId String?
  granted    Int
  remaining  Int
  createdAt  DateTime         @default(now())
  // Arrepentimiento o reembolso del pack: se le quita lo que no se usó.
  revokedAt  DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase   Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  fundings   ListingFunding[]

  @@index([userId, kind, remaining])
  @@index([purchaseId])
}

enum FundingSource {
  LAUNCH_BALANCE
  PACK
  SUBSCRIPTION
  SINGLE_PAYMENT
  COUPON_100
  ADMIN
  LEGACY_BALANCE
}

enum FundingReason {
  PUBLISH
  RENEWAL
  FEATURED
}

// VA-150: con qué se pagó cada publicación, renovación o destacado. Al arrepentirse (o con un
// reembolso o contracargo) se revierte exactamente lo que salió de ese pago. Los avisos anteriores a
// VA-150 no tienen fila: no se tocan.
model ListingFunding {
  id                    String        @id @default(cuid())
  userId                String
  listingKind           ListingKind
  listingId             String
  reason                FundingReason
  source                FundingSource
  purchaseId            String?
  subscriptionId        String?
  creditLotId           String?
  // Renovación: vencimiento que tenía antes (para volver a él). Destacado: hasta cuándo estaba.
  previousExpiresAt     DateTime?
  previousFeaturedUntil DateTime?
  createdAt             DateTime      @default(now())
  revertedAt            DateTime?
  // Pago de Mercado Pago cuyo reembolso lo revirtió.
  revertedPaymentId     String?
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase              Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  creditLot             CreditLot?    @relation(fields: [creditLotId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([subscriptionId, createdAt])
  @@index([creditLotId])
  @@index([listingKind, listingId])
  @@index([revertedPaymentId])
}

