// ==========================================
// 1. AUTENTICACIÓN Y USUARIOS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  phone         String?
  city          String?   // AGREGADO
  province      String?   // AGREGADO
  instagram     String?
  facebook      String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  aircraftListingsBalance   Int @default(0)
  sparePartsListingsBalance Int @default(0)

  accounts   Account[]
  sessions   Session[]
  aircrafts  Aircraft[]
  spareParts SparePart[]
  purchases  Purchase[]
  favorites  Favorite[]
  reports    Report[]
  adBanners  AdBanner[]
  questions  Question[] // Una sola relación para todas sus preguntas
}

// ==========================================
// 4. AERONAVES
// ==========================================

model Aircraft {
  id                    String            @id @default(cuid())
  sellerId              String
  title                 String
  description           String
  modifications         String?
  brand                 AircraftBrand
  customBrand           String?
  model                 String
  year                  Int
  totalTimeHours        Int
  category              AircraftCategory?
  fuselageDescription   String?
  fuselageModifications String?
  avionics              String?
  extraEquipment        String?
  price                 Decimal?          @db.Decimal(12, 2)
  city                  String
  province              String
  status                AircraftStatus    @default(PENDING_PAYMENT)
  listingStartsAt       DateTime?
  listingExpiresAt      DateTime?
  renewalEmailSentAt    DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  purchaseId            String?

  seller    User               @relation(fields: [sellerId], references: [id])
  purchase  Purchase?          @relation(fields: [purchaseId], references: [id])
  images    AircraftImage[]
  documents AircraftDocument[]
  engines   AircraftEngine[]
  propeller AircraftPropeller[]
  leads     Lead[]
  favorites Favorite[]
  reports   Report[]
  tags      Tag[]              @relation("AircraftToTag")
  questions Question[]         // Relación con el modelo único Question

  @@index([brand, model])
  @@index([price])
  @@index([category])
  @@index([status])
  @@index([province, city])
}

// ==========================================
// 5. REPUESTOS Y ACCESORIOS
// ==========================================

model SparePart {
  id                 String             @id @default(cuid())
  sellerId           String
  title              String
  description        String
  brand              String
  model              String
  partNumber         String?
  category           SparePartCategory
  condition          SparePartCondition
  price              Decimal?           @db.Decimal(12, 2)
  city               String
  province           String
  status             SparePartStatus    @default(PENDING_PAYMENT)
  stock              Int                @default(1)
  listingStartsAt    DateTime?
  listingExpiresAt   DateTime?
  renewalEmailSentAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  purchaseId         String?

  seller    User               @relation(fields: [sellerId], references: [id])
  purchase  Purchase?          @relation(fields: [purchaseId], references: [id])
  images    SparePartImage[]
  leads     SparePartLead[]
  favorites Favorite[]
  reports   Report[]
  questions Question[]      

  @@index([category])
  @@index([condition])
  @@index([price])
  @@index([status])
  @@index([province, city])
}

// ==========================================
// 7. PREGUNTAS Y RESPUESTAS (Modelo Único)
// ==========================================

model Question {
  id          String    @id @default(cuid())
  userId      String    
  aircraftId  String?   
  sparePartId String?   
  
  question    String    
  answer      String?   
  answeredAt  DateTime? 
  createdAt   DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft  Aircraft?  @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  sparePart SparePart? @relation(fields: [sparePartId], references: [id], onDelete: Cascade)

  @@index([aircraftId])
  @@index([sparePartId])
  @@index([userId])
}