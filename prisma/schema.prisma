 datasource db {

  provider = "postgresql"
}


generator client {

  provider = "prisma-client-js"
}



// ==========================================
// 1. AUTENTICACIÓN Y USUARIOS (NextAuth)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  phone         String?
  instagram     String?
  facebook      String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  // Contadores / Balances de publicaciones disponibles
  aircraftListingsBalance   Int @default(0)
  sparePartsListingsBalance Int @default(0)

  // Relaciones
  accounts   Account[]
  sessions   Session[]
  aircrafts  Aircraft[]
  spareParts SparePart[]
  purchases  Purchase[]
  favorites  Favorite[]
  reports    Report[]
  adBanners  AdBanner[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 2. SISTEMA DE PLANES, PAGOS Y PACKS
// ==========================================

enum PlanType {
  AIRCRAFT_PACK
  SPARE_PART_PACK
  AD_BANNER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Plan {
  id                    String   @id @default(cuid())
  name                  String
  type                  PlanType
  price                 Decimal  @db.Decimal(12, 2)
  savingsPercent        Int?     // Ej: 10, 20 para badges de descuento
  usageDescription      String?  // Ej: "Pack de 3 publicaciones de aviones"
  includesVerifiedBadge Boolean  @default(false)
  isActive              Boolean  @default(true)

  // Cantidad de publicaciones que otorga el pack (si aplica)
  aircraftListingsCount   Int @default(0)
  sparePartsListingsCount Int @default(0)

  purchases Purchase[]
}

model Purchase {
  id                          String        @id @default(cuid())
  userId                      String
  planId                      String
  
  // Seguimiento de cupos adquiridos en esta compra
  aircraftListingsTotal       Int           @default(0)
  aircraftListingsRemaining   Int           @default(0)
  sparePartsListingsTotal     Int           @default(0)
  sparePartsListingsRemaining Int           @default(0)

  mpPreferenceId              String?
  paymentStatus               PaymentStatus @default(PENDING)
  createdAt                   DateTime      @default(now())

  user       User        @relation(fields: [userId], references: [id])
  plan       Plan        @relation(fields: [planId], references: [id])
  aircrafts  Aircraft[]
  spareParts SparePart[]
  adBanners  AdBanner[]
}

// ==========================================
// 3. PUBLICIDAD / BANNERS (Pago único)
// ==========================================

enum AdBannerStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  REJECTED
}

model AdBanner {
  id             String         @id @default(cuid())
  userId         String
  purchaseId     String?
  
  // Información del banner y del mensaje/comentario del usuario
  title          String?
  description    String         // Comentario / Mensaje descriptivo para el banner o instrucciones
  bannerImageUrl String?        // URL de la imagen del banner
  linkUrl        String?        // Enlace de destino al hacer clic en el banner
  
  status         AdBannerStatus @default(PENDING_PAYMENT)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])
}

// ==========================================
// 4. AERONAVES
// ==========================================

enum AircraftStatus {
  ACTIVE
  PAUSED
  SOLD
  EXPIRED
  PENDING_PAYMENT
}

enum AircraftCategory {
  PISTON
  TURBOHELICE
  EXPERIMENTAL
  HELICOPTERO
  PROYECTO
}

enum AircraftBrand {
  AIR_TRACTOR
  CESSNA
  PIPER
  PZL
  GRUMMAN
  EMBRAER
  BELL
  CICARE
  AIRBUS
  AERO_BOERO
  BEECHCRAFT
  OTHER
}

model Aircraft {
  id                        String            @id @default(cuid())
  sellerId                  String
  title                     String
  description               String
  modifications             String? // analizar si es necesario o como va
  brand                     AircraftBrand
  customBrand               String?
  model                     String
  year                      Int
  totalTimeHours            Int
  category                  AircraftCategory?
  fuselageDescription       String?
  fuselageModifications     String?
  avionics                  String?
  extraEquipment            String?
  price                     Decimal?          @db.Decimal(12, 2) // si es nulo el precio es a consultar
  city                      String
  province                  String
  status                    AircraftStatus    @default(PENDING_PAYMENT)
  listingStartsAt           DateTime?
  listingExpiresAt          DateTime?
  renewalEmailSentAt        DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  purchaseId                String?

  seller    User               @relation(fields: [sellerId], references: [id])
  purchase  Purchase?          @relation(fields: [purchaseId], references: [id])
  images    AircraftImage[]
  documents AircraftDocument[]
  engines   AircraftEngine[]
  propeller AircraftPropeller[]
  leads     Lead[]
  favorites Favorite[]
  reports   Report[]
  tags      Tag[]              @relation("AircraftToTag")

  @@index([brand, model])
  @@index([price])
  @@index([category])
  @@index([status])
  @@index([province, city])
}

model AircraftImage {
  id         String   @id @default(cuid())
  aircraftId String
  url        String
  order      Int      @default(0)

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
}

model AircraftDocument {
  id         String   @id @default(cuid())
  aircraftId String
  url        String
  name       String
  uploadedAt DateTime @default(now())

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
}

model AircraftEngine {
  id            String   @id @default(cuid())
  aircraftId    String
  engineHours   Int?
  TBO           Int
  brand         String? // ver si son marcas diferentes a las de aviones
  model         String?

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
}

model AircraftPropeller {
  id                String   @id @default(cuid())
  aircraftId        String
  propellerHours    Int?
  model             String?

  aircraft Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. REPUESTOS Y ACCESORIOS
// ==========================================

enum SparePartStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  SOLD
}

enum SparePartCategory {
  MECANICO
  ESTRUCTURAL
  PIEZA_MOVIL
  AVIONICA_Y_RADIO
  EQUIPO_DE_FUMIGACION
}

enum SparePartCondition {
  NUEVO
  USADO
  REMANUFACTURADO
}

model SparePart {
  id                 String             @id @default(cuid())
  sellerId           String
  title              String
  description        String
  brand              String
  model              String
  partNumber         String?
  category           SparePartCategory
  condition          SparePartCondition
  price              Decimal?           @db.Decimal(12, 2)
  city               String
  province           String
  status             SparePartStatus    @default(PENDING_PAYMENT)
  stock              Int                @default(1)
  listingStartsAt    DateTime?
  listingExpiresAt   DateTime?
  renewalEmailSentAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  purchaseId         String?

  seller    User             @relation(fields: [sellerId], references: [id])
  purchase  Purchase?        @relation(fields: [purchaseId], references: [id])
  images    SparePartImage[]
  leads     SparePartLead[]
  favorites Favorite[]
  reports   Report[]

  @@index([category])
  @@index([condition])
  @@index([price])
  @@index([status])
  @@index([province, city])
}

model SparePartImage {
  id          String   @id @default(cuid())
  sparePartId String
  url         String
  order       Int      @default(0)

  sparePart SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6. INTERACCIONES (Leads, Favoritos, Reportes y Tags)
// ==========================================

model Lead {
  id         String   @id @default(cuid())
  aircraftId String
  buyerName  String
  buyerEmail String
  buyerPhone String?
  message    String
  createdAt  DateTime @default(now())

  aircraft Aircraft @relation(fields: [aircraftId], references: [id])
}

model SparePartLead {
  id          String   @id @default(cuid())
  sparePartId String
  buyerName   String
  buyerEmail  String
  buyerPhone  String?
  message     String
  createdAt   DateTime @default(now())

  sparePart SparePart @relation(fields: [sparePartId], references: [id])
}

model Favorite {
  id          String     @id @default(cuid())
  userId      String
  aircraftId  String?
  sparePartId String?

  user      User       @relation(fields: [userId], references: [id])
  aircraft  Aircraft?  @relation(fields: [aircraftId], references: [id])
  sparePart SparePart? @relation(fields: [sparePartId], references: [id])

  @@unique([userId, aircraftId, sparePartId])
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model Report {
  id            String       @id @default(cuid())
  userId        String
  aircraftId    String?
  sparePartId   String?
  reason        String
  details       String?
  reporterEmail String?
  status        ReportStatus @default(PENDING)
  createdAt     DateTime     @default(now())

  user      User       @relation(fields: [userId], references: [id])
  aircraft  Aircraft?  @relation(fields: [aircraftId], references: [id])
  sparePart SparePart? @relation(fields: [sparePartId], references: [id])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  aircrafts Aircraft[] @relation("AircraftToTag")
}