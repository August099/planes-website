// --------------------------------------------------------------------------- VA-92 · Pagos y facturación

// Un pago de Mercado Pago (único o cobro de una suscripción). Se crea o actualiza siempre con lo que
// devuelve la API de MP (nunca con el payload del webhook). mpPaymentId único: el mismo pago no se
// registra ni se procesa dos veces.
model Payment {
  id                    String        @id @default(cuid())
  provider              String        @default("MERCADOPAGO")
  mpPaymentId           String        @unique
  // Estado tal como lo informa MP: pending, approved, authorized, in_process, in_mediation,
  // rejected, cancelled, refunded, charged_back.
  status                String
  statusDetail          String?
  amount                Decimal       @db.Decimal(12, 2)
  refundedAmount        Decimal       @default(0) @db.Decimal(12, 2)
  currency              String        @default("ARS")
  method                String?
  paymentType           String?
  approvedAt            DateTime?
  purchaseId            String?
  subscriptionId        String?
  // VA-105: live_mode que informa la API de MP y si es un pago de prueba (credenciales o cuentas de
  // prueba). Un pago de prueba nunca genera una factura real ni cuenta en el tope ni en los KPIs.
  liveMode              Boolean?
  isTest                Boolean       @default(false)
  // VA-125: botón de arrepentimiento (hasta 10 días del pago): cuándo lo pidió el usuario.
  withdrawalRequestedAt DateTime?
  raw                   Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  purchase              Purchase?     @relation(fields: [purchaseId], references: [id])
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  invoices              Invoice[]

  @@index([purchaseId])
  @@index([subscriptionId])
  @@index([status, createdAt])
}

// Cada notificación recibida, con firma válida o no. Se guarda antes de procesar y se responde 200
// rápido; el procesamiento deja el resultado acá (status, error, attempts).
model WebhookEvent {
  id             String        @id @default(cuid())
  provider       String        @default("MERCADOPAGO")
  topic          String
  action         String?
  externalId     String?
  requestId      String?
  signatureValid Boolean
  payload        Json
  status         WebhookStatus @default(RECEIVED)
  error          String?       @db.Text
  attempts       Int           @default(0)
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?

  @@index([provider, externalId])
  @@index([status, receivedAt])
}

// Factura C o nota de crédito C emitida con TusFacturasAPP. TusFacturas no controla el
// external_reference repetido: la unicidad la garantiza la base.
model Invoice {
  id                String        @id @default(cuid())
  kind              InvoiceKind
  status            InvoiceStatus @default(PENDING)
  paymentId         String
  // = paymentId solo en las facturas (null en las notas de crédito): una factura por pago.
  invoicedPaymentId String?       @unique
  // Notas de crédito: el reembolso de MP que la originó (una por reembolso, también los parciales)
  // o el id de la anulación manual.
  refundRef         String?       @unique
  originalInvoiceId String?
  pointOfSale       Int?
  number            Int?
  cae               String?
  caeExpiresAt      DateTime?
  total             Decimal       @db.Decimal(12, 2)
  periodFrom        DateTime
  periodTo          DateTime
  description       String
  // Datos del receptor con los que se emitió (copia de los datos de facturación de la compra).
  receiver          Json
  arcaObservations  String?       @db.Text
  errors            String?       @db.Text
  attempts          Int           @default(0)
  nextAttemptAt     DateTime?
  issuedAt          DateTime?
  // Ruta en el bucket privado de Supabase (el PDF de TusFacturas es temporal).
  pdfPath           String?
  // VA-105: cómo se procesó (production, development o simulated) y el JSON enviado (o que se habría
  // enviado) a TusFacturas, sin credenciales.
  mode              String?
  requestPayload    Json?
  // VA-105: "Descartar (prueba interna)": quién y cuándo.
  skippedAt         DateTime?
  skippedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  payment           Payment       @relation(fields: [paymentId], references: [id])
  originalInvoice   Invoice?      @relation("CreditNotes", fields: [originalInvoiceId], references: [id])
  creditNotes       Invoice[]     @relation("CreditNotes")

  @@unique([kind, pointOfSale, number])
  @@index([status, nextAttemptAt])
  @@index([issuedAt])
  @@index([paymentId])
}

// Datos de facturación del usuario (se completan al comprar y se reutilizan).
model BillingProfile {
  id           String           @id @default(cuid())
  userId       String           @unique
  kind         BillingPartyKind
  // DNI (consumidor final, obligatorio desde BillingSettings.dniRequiredFrom) o CUIT (empresa).
  docType      String?
  docNumber    String?
  name         String
  // Condición frente al IVA con los códigos de TusFacturas: CF, M (monotributo), RI, E (exento).
  ivaCondition String           @default("CF")
  email        String
  address      String?
  province     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Configuración de facturación editable desde el admin (una sola fila, id "default").
model BillingSettings {
  id                    String    @id @default("default")
  // Tope anual de la categoría del monotributo (solo indicador, no bloquea) y umbral de alerta.
  monotributoAnnualCap  Decimal?  @db.Decimal(14, 2)
  alertThresholdPercent Int       @default(80)
  lastCapAlertAt        DateTime?
  // Desde qué monto el consumidor final tiene que informar DNI (regla de ARCA, configurable).
  dniRequiredFrom       Decimal   @default(10000000) @db.Decimal(14, 2)
  // Días de gracia de una suscripción con un cobro rechazado.
  graceDays             Int       @default(7)
  // Reintentos de una factura con error antes de avisar al admin.
  maxInvoiceAttempts    Int       @default(5)
  updatedAt             DateTime  @default(now()) @updatedAt
}

