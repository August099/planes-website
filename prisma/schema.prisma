generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String               @id @default(cuid())
  name                      String?
  email                     String               @unique
  emailVerified             DateTime?
  passwordHash              String?
  image                     String?
  phone                     String?
  bio                       String?
  isAdmin                   Boolean              @default(false)
  createdAt                 DateTime             @default(now())
  // VA-111: cuándo vio (y cerró) la ventana de bienvenida. null = todavía no. (VA-152: los saldos de
  // publicaciones y el de lanzamiento se quitaron; el cupo está en lib/quota.ts.)
  launchWelcomeSeenAt       DateTime?
  facebook                  String?
  instagram                 String?
  city                      String?
  province                  String?
  userType                  UserType             @default(PARTICULAR)
  // VA-87: el usuario ya eligió su tipo de cuenta (en /register o en /onboarding/account-type).
  userTypeConfirmed         Boolean              @default(false)
  // VA-87: página personalizada (solo con un plan que la incluya, lib/subscriptions.ts).
  businessName              String?
  coverUrl                  String?
  logoUrl                   String?
  website                   String?
  whatsapp                  String?
  accounts                  Account[]
  adBanners                 AdBanner[]
  aircrafts                 Aircraft[]
  analyticsEvents           AnalyticsEvent[]     @relation("AnalyticsEventUser")
  // VA-151: visitas a su perfil (Página VA), sin datos del visitante.
  profileViews              AnalyticsEvent[]     @relation("AnalyticsEventProfile")
  couponUsages              CouponUsage[]
  favorites                 Favorite[]
  purchases                 Purchase[]
  questions                 Question[]
  reports                   Report[]
  sessions                  Session[]
  spareParts                SparePart[]
  hangars                   Hangar[]
  // VA-84: créditos de publicación de hangares (los suma el webhook de Mercado Pago, Fase 6).
  hangarListingsBalance     Int                  @default(0)
  // VA-92: datos de facturación guardados para la próxima compra.
  billingProfile            BillingProfile?
  Subscription              Subscription?
  listingPriceChanges       ListingPriceChange[]
  // VA-105 · 3: al cambiar o restablecer la contraseña se cierran las sesiones iniciadas antes (callback jwt).
  passwordChangedAt         DateTime?
  passwordResetTokens       PasswordResetToken[]
  // VA-150: lotes de saldo y registro de con qué se pagó cada aviso.
  creditLots                CreditLot[]
  listingFundings           ListingFunding[]
  // VA-154: historial de moderación de sus avisos (como dueño) y de las acciones que hizo (como admin).
  moderationActions         ModerationAction[]   @relation("ModerationOwner")
  moderationDone            ModerationAction[]   @relation("ModerationAdmin")
  // VA-167: republicaciones hechas (el saldo del año sale de contarlas).
  republications            Republication[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// VA-105 · 3: "Olvidé mi contraseña". Se guarda solo el hash (SHA-256) del token; vence en 1 hora,
// es de un solo uso y pedir uno nuevo invalida los anteriores (usedAt).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// VA-105 · 3: límite de pedidos (por email y por IP, guardados como hash). Se reutiliza para otros límites.
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Plan {
  id                      String           @id @default(cuid())
  name                    String
  type                    PlanType
  // VA-152/VA-166: nivel del plan (Base, Pro o Broker). null = plan del modelo anterior (packs o
  // "Pago de prueba"), que queda archivado porque tiene compras. Base y Pro: aircraftListingsCount y
  // sparePartsListingsCount son el CUPO de avisos activos al mismo tiempo. Broker (BUSINESS): 3 filas
  // (solo aviones, solo repuestos o ambos ilimitados); lo que no es ilimitado tiene el cupo de Base.
  tier                    PlanTier?
  // VA-166: precio real (el que se cobra, "Promo de lanzamiento") y precio tachado (solo se muestra).
  price                   Decimal          @db.Decimal(12, 2)
  listPrice               Decimal?         @db.Decimal(12, 2)
  savingsPercent          Int?
  usageDescription        String?
  includesVerifiedBadge   Boolean          @default(false)
  // VA-166: beneficios según la grilla de los socios (interruptores del admin).
  // Republicaciones (VA-167): por año (Base 2, Pro 5) o "Republicar todas" cada N días (Broker: 30).
  republishesPerYear      Int              @default(0)
  republishAllEveryDays   Int?
  // Destacadas (VA-168), Página VA (VA-169: ninguna, banner del Pro o completa del Broker), detalles
  // personalizados (VA-170) y nivel de métricas (VA-171).
  includesFeatured        Boolean          @default(false)
  vaPageLevel             VaPageLevel      @default(NONE)
  includesCustomDetail    Boolean          @default(false)
  metricsLevel            MetricsLevel     @default(BASIC)
  isActive                Boolean          @default(true)
  aircraftListingsCount   Int              @default(0)
  sparePartsListingsCount Int              @default(0)
  billingInterval         BillingInterval?
  billingType             PlanBillingType  @default(ONE_TIME)
  isUnlimitedAircraft     Boolean          @default(false)
  isUnlimitedSpareParts   Boolean          @default(false)
  // VA-84: hangares, con el mismo patrón que aeronaves y repuestos.
  hangarListingsCount     Int              @default(0)
  isUnlimitedHangars      Boolean          @default(false)
  showInHangarsTab        Boolean          @default(false)
  // VA-80: lo que se muestra en /plans (la lógica usa los campos de arriba).
  currency                String           @default("ARS")
  description             String?
  features                String[]         @default([])
  badge                   String?
  isPopular               Boolean          @default(false)
  showInAircraftTab       Boolean          @default(false)
  showInPartsTab          Boolean          @default(false)
  sortOrder               Int              @default(0)
  // VA-80: archivado = fuera de /plans y del alta, pero conserva compras y suscripciones.
  archivedAt              DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @default(now()) @updatedAt
  purchases               Purchase[]
  subscriptions           Subscription[]
}

// VA-59: precio por menor de publicar un avión o un repuesto, editable desde /admin/prices.
// Una fila por tipo. Lo que se cobre se lee siempre de acá en el servidor (Fase 6).
model ListingPrice {
  kind      ListingKind @id
  amount    Decimal     @db.Decimal(12, 2)
  currency  String      @default("ARS")
  updatedAt DateTime    @updatedAt
}

// VA-59: historial de cambios de precio (quién, cuándo, de cuánto a cuánto).
model ListingPriceChange {
  id             String      @id @default(cuid())
  kind           ListingKind
  previousAmount Decimal     @db.Decimal(12, 2)
  newAmount      Decimal     @db.Decimal(12, 2)
  currency       String      @default("ARS")
  adminId        String?
  admin          User?       @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@index([kind, createdAt])
}

// VA-85: guías de /services/guides, editables desde /admin/guides. Solo las PUBLISHED se ven en
// el sitio, el sitemap y el JSON-LD; las DRAFT dan 404 al público y el admin las ve en la vista previa.
model Guide {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String
  audience        GuideAudience
  // Nombre de un ícono de lucide (de la lista de lib/guide-icons.ts).
  icon            String
  metaDescription String
  // [{ heading, id?, paragraphs[], bullets[], links[{ label, href }] }]
  sections        Json
  // Fuente oficial con link visible ({ label, href }) y botones al pie ([{ label, href }]).
  source          Json?
  cta             Json          @default("[]")
  // El glosario se muestra como lista de definiciones y publica DefinedTermSet.
  isGlossary      Boolean       @default(false)
  status          GuideStatus   @default(DRAFT)
  order           Int           @default(0)
  reviewedBy      String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, order])
}

// VA-84: hangares (alquiler de espacio, de hangar completo y venta). Mismos estados y vencimiento que
// las aeronaves. Puede ofrecerse en venta, en alquiler o las dos cosas (al menos una): cada una con
// su precio y moneda; el alquiler, además, con su período. Precio vacío con la opción marcada =
// "a convenir".
model Hangar {
  id               String               @id @default(cuid())
  sellerId         String
  title            String
  description      String
  // Ubicación
  airfieldName     String
  icaoCode         String?
  city             String
  province         String
  latitude         Float?
  longitude        Float?
  // Para asociarlo al futuro directorio de pistas (nulo por ahora).
  airfieldId       String?
  // Medidas en metros (puerta obligatoria) y superficie en m²
  doorWidth        Float
  doorHeight       Float
  interiorWidth    Float?
  interiorDepth    Float?
  area             Float?
  // Capacidad y servicios
  spaceType        HangarSpaceType?
  spots            Int?
  aircraftTypes    HangarAircraftType[]
  services         HangarService[]
  // Venta
  offersSale       Boolean              @default(false)
  salePrice        Decimal?             @db.Decimal(14, 2)
  saleCurrency     ListingCurrency      @default(USD)
  // Alquiler
  offersRent       Boolean              @default(false)
  rentalType       HangarRentalType?
  rentPrice        Decimal?             @db.Decimal(12, 2)
  rentCurrency     ListingCurrency      @default(ARS)
  rentPeriod       HangarRentPeriod?
  negotiable       Boolean              @default(false)
  // Disponibilidad: null = disponible ahora
  availableFrom    DateTime?
  // Estado y vencimiento (igual que Aircraft)
  status           AircraftStatus       @default(PENDING_PAYMENT)
  listingStartsAt  DateTime?
  listingExpiresAt DateTime?
  // VA-95: destacado pago o incluido en el plan, vigente hasta esta fecha.
  featuredUntil    DateTime?
  purchaseId       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  seller           User                 @relation(fields: [sellerId], references: [id])
  purchase         Purchase?            @relation(fields: [purchaseId], references: [id])
  images           HangarImage[]
  favorites        Favorite[]
  questions        Question[]
  reports          Report[]
  analyticsEvents  AnalyticsEvent[]

  @@index([status, listingExpiresAt, createdAt])
  @@index([province, city])
  @@index([doorWidth])
  @@index([salePrice])
  @@index([rentPrice])
  @@index([sellerId])
  @@index([featuredUntil])
}

model HangarImage {
  id       String @id @default(cuid())
  hangarId String
  url      String
  order    Int    @default(0)
  hangar   Hangar @relation(fields: [hangarId], references: [id], onDelete: Cascade)

  @@index([hangarId, order])
}

model Purchase {
  id                String           @id @default(cuid())
  userId            String
  // VA-92: opcional. Un aviso suelto se cobra al precio de ListingPrice (listingKind), sin Plan.
  planId            String?
  listingKind       ListingKind?
  // Concepto que se cobra y se factura ("Publicación de aeronave – Plan 1 Avión").
  description       String           @default("")
  currency          String           @default("ARS")
  mpPreferenceId    String?
  paymentStatus     PaymentStatus    @default(PENDING)
  // VA-92: cuándo se aprobó el pago y cuándo se entregó lo comprado. activatedAt hace idempotente
  // la activación: se marca en la misma transacción que acredita el saldo o activa el aviso.
  approvedAt        DateTime?
  activatedAt       DateTime?
  // Datos de facturación usados en esta compra (copia del BillingProfile en ese momento).
  billingSnapshot   Json?
  // VA-95: compra de un destacado: cuántos días y para qué aviso (tipo + id, sin FK para no duplicar
  // la relación de la publicación).
  featuredDays      Int?
  featuredKind      ListingKind?
  featuredListingId String?
  // VA-105 (14/10): renovación paga de un aviso vencido (tipo + id, sin FK, igual que los destacados).
  renewalKind       ListingKind?
  renewalListingId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  couponId          String?
  discountAmount    Decimal          @default(0) @db.Decimal(12, 2)
  finalPrice        Decimal          @default(0) @db.Decimal(12, 2)
  originalPrice     Decimal          @default(0) @db.Decimal(12, 2)
  adBanners         AdBanner[]
  aircrafts         Aircraft[]
  couponUsage       CouponUsage?
  coupon            Coupon?          @relation(fields: [couponId], references: [id])
  plan              Plan?            @relation(fields: [planId], references: [id], onDelete: Restrict)
  user              User             @relation(fields: [userId], references: [id])
  spareParts        SparePart[]
  hangars           Hangar[]
  payments          Payment[]
  creditLots        CreditLot[]
  listingFundings   ListingFunding[]

  @@index([userId, createdAt])
  @@index([paymentStatus, createdAt])
  // VA-105: reservas de cupón (compras pendientes con cupón) al validar el límite de usos.
  @@index([couponId, paymentStatus])
}

model Subscription {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  planId                  String
  status                  SubscriptionStatus @default(ACTIVE)
  mpSubscriptionId        String?            @unique
  stripeSubscriptionId    String?            @unique
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  cancelAtPeriodEnd       Boolean            @default(false)
  // VA-92: MANUAL = cortesía asignada desde el admin: sin Mercado Pago, no se cobra ni se renueva y no
  // cuenta en ingresos ni en los KPIs (VA-102).
  source                  SubscriptionSource @default(MERCADOPAGO)
  grantedById             String?
  note                    String?
  // VA-92: estado del preapproval en Mercado Pago (pending, authorized, paused, cancelled) y
  // gracia tras un cobro rechazado: vencida graceUntil, pierde los beneficios.
  mpStatus                String?
  graceUntil              DateTime?
  lastPaymentAt           DateTime?
  // VA-121: cambio de plan inmediato (sin prorrateo). El preapproval del plan nuevo queda acá hasta
  // que Mercado Pago aprueba su primer cobro; recién ahí reemplaza al actual (que se cancela en MP).
  // Si el usuario no completa el pago, sigue con su plan de siempre.
  pendingPlanId           String?
  pendingMpSubscriptionId String?            @unique
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  plan                    Plan               @relation(fields: [planId], references: [id])
  user                    User               @relation(fields: [userId], references: [id])
  payments                Payment[]
  listingFundings         ListingFunding[]
}

model AdBanner {
  id             String         @id @default(cuid())
  userId         String
  purchaseId     String?
  title          String?
  description    String
  bannerImageUrl String?
  linkUrl        String?
  status         AdBannerStatus @default(PENDING_PAYMENT)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  purchase       Purchase?      @relation(fields: [purchaseId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
}

model AircraftBrand {
  id        String          @id @default(cuid())
  name      String          @unique
  logoUrl   String?
  aircrafts Aircraft[]
  models    AircraftModel[]
}

model AircraftModel {
  id                String             @id @default(cuid())
  brandId           String
  name              String
  // VA-165: categoría recomendada (era defaultCategoryId, VA-153): el formulario la propone y se puede cambiar.
  recommendedCategoryId String?
  aircrafts         Aircraft[]
  brand             AircraftBrand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  AircraftCategory  AircraftCategory?  @relation(fields: [recommendedCategoryId], references: [id])
  variants          AircraftSubModel[]

  @@unique([brandId, name])
}

model AircraftSubModel {
  id               String            @id @default(cuid())
  modelId          String
  name             String
  categoryOverride String?
  aircrafts        Aircraft[]
  AircraftCategory AircraftCategory? @relation(fields: [categoryOverride], references: [id])
  model            AircraftModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, name])
}

model AircraftCategory {
  id                   String             @id @default(cuid())
  name                 String             @unique
  aircrafts            Aircraft[]
  defaultForModels     AircraftModel[]
  overrideForSubModels AircraftSubModel[]
}

model Aircraft {
  id               String              @id @default(cuid())
  sellerId         String
  title            String
  customBrand      String?
  year             Int
  totalTimeHours   Int?
  price            Decimal?            @db.Decimal(12, 2)
  city             String
  province         String
  // VA-152: sin vencimiento; ACTIVE cuenta en el cupo (lib/quota.ts).
  status           AircraftStatus      @default(ACTIVE)
  listingStartsAt  DateTime?
  // VA-95: destacado pago o incluido en el plan, vigente hasta esta fecha.
  featuredUntil    DateTime?
  createdAt        DateTime            @default(now())
  // VA-167: última vez que se publicó (alta o republicación). Ordena "Más recientes" y "Últimas
  // publicaciones"; el detalle muestra "Actualizado el …" si es posterior al alta.
  lastPublishedAt  DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  purchaseId       String?
  description      String
  plate            String?
  certified        Boolean             @default(false)
  certDate         DateTime?
  intDescription   String?
  passengers       Int?
  airconditioner   Boolean             @default(false)
  oxygen           Boolean             @default(false)
  extDescription   String?
  categoryId       String
  customModel      String?
  financing        Boolean             @default(false)
  trade            Boolean             @default(false)
  rent             Boolean             @default(false)
  negotiable       Boolean             @default(false)
  extraEquipment   String?
  agEquipment      String?
  avDescription    String?
  avAaptoifr       Boolean             @default(false)
  avAutopilot      Boolean             @default(false)
  brandId          String?
  condition        AircraftCondition   @default(USADO)
  engineType       EngineType?
  modelId          String?
  subModelId       String?
  brand            AircraftBrand?      @relation(fields: [brandId], references: [id])
  category         AircraftCategory    @relation(fields: [categoryId], references: [id])
  model            AircraftModel?      @relation(fields: [modelId], references: [id])
  purchase         Purchase?           @relation(fields: [purchaseId], references: [id])
  seller           User                @relation(fields: [sellerId], references: [id])
  subModel         AircraftSubModel?   @relation(fields: [subModelId], references: [id])
  documents        AircraftDocument[]
  engines          AircraftEngine[]
  images           AircraftImage[]
  propeller        AircraftPropeller[]
  analyticsEvents  AnalyticsEvent[]
  favorites        Favorite[]
  leads            Lead[]
  questions        Question[]
  reports          Report[]
  republications   Republication[]
  tags             Tag[]               @relation("AircraftToTag")
  // VA-83: centroide de la localidad (API Georef), para el mapa de zona aproximada.
  latitude         Float?
  longitude        Float?

  @@index([price])
  @@index([status, createdAt])
  @@index([status, lastPublishedAt])
  @@index([brandId, modelId])
  @@index([province, city])
  @@index([year])
  @@index([sellerId])
  @@index([featuredUntil])
  @@index([categoryId])
}

model AircraftImage {
  id         String   @id @default(cuid())
  aircraftId String
  url        String
  order      Int      @default(0)
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId, order])
}

model AircraftDocument {
  id         String   @id @default(cuid())
  aircraftId String
  url        String
  name       String
  uploadedAt DateTime @default(now())
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId])
}

model AircraftEngine {
  id          String   @id @default(cuid())
  aircraftId  String
  engineHours Int?
  TBO         Int?
  horsepower  Int?
  brand       String?
  model       String?
  description String?
  aircraft    Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId])
}

model AircraftPropeller {
  id             String   @id @default(cuid())
  aircraftId     String
  propellerHours Int?
  brand          String?
  model          String?
  description    String?
  aircraft       Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([aircraftId])
}

model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  icon         String?
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryTree")
  products     SparePart[]
  filterGroups FilterGroup[] @relation("CategoryFilterGroups")
}

model FilterGroup {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  filters    Filter[]
  categories Category[] @relation("CategoryFilterGroups")
}

model Filter {
  id        String              @id @default(cuid())
  name      String
  slug      String
  type      FilterType
  order     Int                 @default(0)
  groupId   String
  parentId  String?
  config    Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  values    EntityFilterValue[]
  group     FilterGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent    Filter?             @relation("FilterHierarchy", fields: [parentId], references: [id])
  children  Filter[]            @relation("FilterHierarchy")
  options   FilterOption[]

  @@unique([groupId, slug])
  @@index([parentId])
}

model FilterOption {
  id           String              @id @default(cuid())
  label        String
  value        String
  order        Int                 @default(0)
  filterId     String
  extra        Json?
  entityValues EntityFilterValue[]
  filter       Filter              @relation(fields: [filterId], references: [id], onDelete: Cascade)

  @@unique([filterId, value])
}

model EntityFilterValue {
  id           String        @id @default(cuid())
  productId    String
  filterId     String
  optionId     String?
  valueString  String?
  valueNumber  Float?
  valueBoolean Boolean?
  filter       Filter        @relation(fields: [filterId], references: [id], onDelete: Cascade)
  option       FilterOption? @relation(fields: [optionId], references: [id])
  product      SparePart     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, filterId, optionId])
  @@index([productId])
  @@index([filterId])
}

model SparePart {
  id               String              @id @default(cuid())
  sellerId         String
  title            String
  partNumber       String?
  price            Decimal?            @db.Decimal(12, 2)
  city             String
  province         String
  // VA-152: sin vencimiento; ACTIVE cuenta en el cupo (lib/quota.ts).
  status           SparePartStatus     @default(ACTIVE)
  condition        SparepartCondition  @default(USADO)
  listingStartsAt  DateTime?
  // VA-95: destacado pago o incluido en el plan, vigente hasta esta fecha.
  featuredUntil    DateTime?
  createdAt        DateTime            @default(now())
  // VA-167: última vez que se publicó (alta o republicación). Ordena "Más recientes" y "Últimas
  // publicaciones"; el detalle muestra "Actualizado el …" si es posterior al alta.
  lastPublishedAt  DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  purchaseId       String?
  description      String
  stock            Int                 @default(1)
  categoryId       String
  brand            String?
  aircrafts        String[]
  attributes       Json?               @default("{}")
  inPesos          Boolean             @default(false)
