generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String           @id @default(cuid())
  name                      String?
  email                     String           @unique
  emailVerified             DateTime?
  passwordHash              String?
  image                     String?
  phone                     String?
  isAdmin                   Boolean          @default(false)
  createdAt                 DateTime         @default(now())
  aircraftListingsBalance   Int              @default(0)
  sparePartsListingsBalance Int              @default(0)
  facebook                  String?
  instagram                 String?
  city                      String?
  province                  String?
  userType                  UserType         @default(PARTICULAR)
  accounts                  Account[]
  adBanners                 AdBanner[]
  aircrafts                 Aircraft[]
  analyticsEvents           AnalyticsEvent[]
  favorites                 Favorite[]
  purchases                 Purchase[]
  questions                 Question[]
  reports                   Report[]
  sessions                  Session[]
  spareParts                SparePart[]
  Subscription              Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Plan {
  id                      String           @id @default(cuid())
  name                    String
  type                    PlanType
  price                   Decimal          @db.Decimal(12, 2)
  savingsPercent          Int?
  usageDescription        String?
  includesVerifiedBadge   Boolean          @default(false)
  isActive                Boolean          @default(true)
  aircraftListingsCount   Int              @default(0)
  sparePartsListingsCount Int              @default(0)
  billingInterval         BillingInterval?
  billingType             PlanBillingType  @default(ONE_TIME)
  isUnlimitedAircraft     Boolean          @default(false)
  isUnlimitedSpareParts   Boolean          @default(false)
  purchases               Purchase[]
  subscriptions           Subscription[]
}

model Purchase {
  id             String        @id @default(cuid())
  userId         String
  planId         String
  mpPreferenceId String?
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  adBanners      AdBanner[]
  aircrafts      Aircraft[]
  plan           Plan          @relation(fields: [planId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  spareParts     SparePart[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  mpSubscriptionId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  plan                 Plan               @relation(fields: [planId], references: [id])
  user                 User               @relation(fields: [userId], references: [id])
}

model AdBanner {
  id             String         @id @default(cuid())
  userId         String
  purchaseId     String?
  title          String?
  description    String
  bannerImageUrl String?
  linkUrl        String?
  status         AdBannerStatus @default(PENDING_PAYMENT)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  purchase       Purchase?      @relation(fields: [purchaseId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
}

model AircraftCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  aircrafts Aircraft[]
}

model AircraftBrand {
  id        String          @id @default(cuid())
  name      String          @unique
  aircrafts Aircraft[]
  models    AircraftModel[]
}

model AircraftModel {
  id        String             @id @default(cuid())
  brandId   String
  name      String
  aircrafts Aircraft[]
  brand     AircraftBrand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants  AircraftSubModel[]

  @@unique([brandId, name])
}

model AircraftSubModel {
  id        String        @id @default(cuid())
  modelId   String
  name      String
  aircrafts Aircraft[]
  model     AircraftModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, name])
}

model Aircraft {
  id               String              @id @default(cuid())
  sellerId         String
  title            String
  customBrand      String?
  year             Int
  totalTimeHours   Int
  price            Decimal?            @db.Decimal(12, 2)
  city             String
  province         String
  status           AircraftStatus      @default(PENDING_PAYMENT)
  listingStartsAt  DateTime?
  listingExpiresAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  purchaseId       String?
  description      String
  categoryId       String
  customModel      String?
  financing        Boolean             @default(false)
  trade            Boolean             @default(false)
  brandId          String?
  condition        AircraftCondition   @default(USADO)
  engineType       EngineType?
  modelId          String?
  subModelId       String?
  brand            AircraftBrand?      @relation(fields: [brandId], references: [id])
  category         AircraftCategory    @relation(fields: [categoryId], references: [id])
  model            AircraftModel?      @relation(fields: [modelId], references: [id])
  purchase         Purchase?           @relation(fields: [purchaseId], references: [id])
  seller           User                @relation(fields: [sellerId], references: [id])
  subModel         AircraftSubModel?   @relation(fields: [subModelId], references: [id])
  documents        AircraftDocument[]
  engines          AircraftEngine[]
  images           AircraftImage[]
  propeller        AircraftPropeller[]
  analyticsEvents  AnalyticsEvent[]
  favorites        Favorite[]
  leads            Lead[]
  questions        Question[]
  reports          Report[]
  tags             Tag[]               @relation("AircraftToTag")

  @@index([price])
  @@index([status])
  @@index([brandId, modelId])
  @@index([province, city])
  @@index([year])
}

model AircraftImage {
  id         String   @id @default(cuid())
  aircraftId String
  url        String
  order      Int      @default(0)
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
}

model AircraftDocument {
  id         String   @id @default(cuid())
  aircraftId String
  url        String
  name       String
  uploadedAt DateTime @default(now())
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
}

model AircraftEngine {
  id          String   @id @default(cuid())
  aircraftId  String
  engineHours Int?
  TBO         Int
  brand       String?
  model       String?
  aircraft    Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
}

model AircraftPropeller {
  id             String   @id @default(cuid())
  aircraftId     String
  propellerHours Int?
  model          String?
  aircraft       Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
}

model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  icon         String?
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryTree")
  products     SparePart[]
  filterGroups FilterGroup[] @relation("CategoryFilterGroups")
}

model FilterGroup {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  filters    Filter[]
  categories Category[] @relation("CategoryFilterGroups")
}

model Filter {
  id        String              @id @default(cuid())
  name      String
  slug      String
  type      FilterType
  order     Int                 @default(0)
  groupId   String
  parentId  String?
  config    Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  values    EntityFilterValue[]
  group     FilterGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent    Filter?             @relation("FilterHierarchy", fields: [parentId], references: [id])
  children  Filter[]            @relation("FilterHierarchy")
  options   FilterOption[]

  @@unique([groupId, slug])
  @@index([parentId])
}

model FilterOption {
  id           String              @id @default(cuid())
  label        String
  value        String
  order        Int                 @default(0)
  filterId     String
  extra        Json?
  entityValues EntityFilterValue[]
  filter       Filter              @relation(fields: [filterId], references: [id], onDelete: Cascade)

  @@unique([filterId, value])
}

model EntityFilterValue {
  id           String        @id @default(cuid())
  productId    String
  filterId     String
  optionId     String?
  valueString  String?
  valueNumber  Float?
  valueBoolean Boolean?
  filter       Filter        @relation(fields: [filterId], references: [id], onDelete: Cascade)
  option       FilterOption? @relation(fields: [optionId], references: [id])
  product      SparePart     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, filterId, optionId])
  @@index([productId])
  @@index([filterId])
}

model SparePart {
  id               String              @id @default(cuid())
  sellerId         String
  title            String
  partNumber       String?
  price            Decimal?            @db.Decimal(12, 2)
  city             String
  province         String
  status           SparePartStatus     @default(PENDING_PAYMENT)
  listingStartsAt  DateTime?
  listingExpiresAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  purchaseId       String?
  description      String
  stock            Int                 @default(1)
  categoryId       String
  attributes       Json                @default("{}")
  analyticsEvents  AnalyticsEvent[]
  filterValues     EntityFilterValue[]
  favorites        Favorite[]
  questions        Question[]
  reports          Report[]
  category         Category            @relation(fields: [categoryId], references: [id])
  purchase         Purchase?           @relation(fields: [purchaseId], references: [id])
  seller           User                @relation(fields: [sellerId], references: [id])
  images           SparePartImage[]
  leads            SparePartLead[]

  @@index([price])
  @@index([status])
  @@index([province, city])
}

model SparePartImage {
  id          String    @id @default(cuid())
  sparePartId String
  url         String
  order       Int       @default(0)
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
}

model Lead {
  id         String   @id @default(cuid())
  aircraftId String
  buyerName  String
  buyerEmail String
  buyerPhone String?
  message    String
  createdAt  DateTime @default(now())
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id])
}

model SparePartLead {
  id          String    @id @default(cuid())
  sparePartId String
  buyerName   String
  buyerEmail  String
  buyerPhone  String?
  message     String
  createdAt   DateTime  @default(now())
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
}

model Favorite {
  id          String     @id @default(cuid())
  userId      String
  aircraftId  String?
  sparePartId String?
  aircraft    Aircraft?  @relation(fields: [aircraftId], references: [id])
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@unique([userId, aircraftId, sparePartId])
}

model Report {
  id            String       @id @default(cuid())
  aircraftId    String?
  sparePartId   String?
  reason        String
  details       String?
  reporterEmail String?
  status        ReportStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  userId        String
  aircraft      Aircraft?    @relation(fields: [aircraftId], references: [id])
  sparePart     SparePart?   @relation(fields: [sparePartId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  aircrafts Aircraft[] @relation("AircraftToTag")
}

model Question {
  id          String     @id @default(cuid())
  userId      String
  aircraftId  String?
  sparePartId String?
  question    String
  answer      String?
  answeredAt  DateTime?
  createdAt   DateTime   @default(now())
  aircraft    Aircraft?  @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aircraftId])
  @@index([sparePartId])
  @@index([userId])
}

model AnalyticsEvent {
  id          String             @id @default(cuid())
  eventType   AnalyticsEventType
  userId      String?
  anonymousId String?
  aircraftId  String?
  sparePartId String?
  metadata    Json               @default("{}")
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime           @default(now())
  aircraft    Aircraft?          @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  sparePart   SparePart?         @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id])

  @@index([eventType, createdAt])
  @@index([aircraftId, eventType])
  @@index([sparePartId, eventType])
  @@index([userId])
  @@index([anonymousId])
}

enum UserType {
  PARTICULAR
  RESELLER
  FACTORY
}

enum PlanType {
  AIRCRAFT_PACK
  SPARE_PART_PACK
  AD_BANNER
  SUBSCRIPTION
}

enum PlanBillingType {
  ONE_TIME
  SUBSCRIPTION
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum AdBannerStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  REJECTED
}

enum EngineType {
  PISTON
  TURBOPROP
}

enum AircraftCondition {
  NUEVO
  USADO
}

enum AircraftStatus {
  ACTIVE
  PAUSED
  SOLD
  EXPIRED
  PENDING_PAYMENT
}

enum SparePartStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  SOLD
}

enum FilterType {
  SELECT
  MULTI_SELECT
  RANGE
  BOOLEAN
  COLOR
  TEXT
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum AnalyticsEventType {
  PAGE_VIEW
  AIRCRAFT_VIEW
  SPARE_PART_VIEW
  SEARCH
  FILTER_APPLIED
  CONTACT_SELLER
  WHATSAPP_CLICK
  PHONE_CLICK
  EMAIL_CLICK
  CREATE_AIRCRAFT_LISTING
  CREATE_SPARE_PART_LISTING
}
