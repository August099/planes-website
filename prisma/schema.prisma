// VA-154: acciones de moderación sobre un aviso.
enum ModerationActionType {
  // El admin lo pausa indefinidamente (desde un reporte), con motivo.
  PAUSE
  // El dueño lo editó y pide revisión.
  REVIEW_REQUESTED
  // El admin lo reactiva (activo si hay cupo; si no, pausado común).
  REACTIVATE
  // El admin lo mantiene pausado, con un mensaje nuevo.
  KEEP_PAUSED
}

// VA-154: historial de moderación por aviso (quién, cuándo, motivo). La pausa vigente es la última
// acción de un aviso MODERATED; la cola "Revisiones pendientes" son los MODERATED cuya última acción es
// REVIEW_REQUESTED. La ventana flotante del dueño sale para las acciones del admin (PAUSE, REACTIVATE,
// KEEP_PAUSED) sin ownerAcknowledgedAt: una vez por acción, y vuelve si no la cierra.
model ModerationAction {
  id                  String               @id @default(cuid())
  listingKind         ListingKind
  listingId           String
  action              ModerationActionType
  // Motivo (PAUSE), mensaje (KEEP_PAUSED / REACTIVATE) o comentario del dueño (REVIEW_REQUESTED).
  message             String?
  ownerId             String
  // Admin que actuó (null en REVIEW_REQUESTED, que lo pide el dueño).
  adminId             String?
  // Reporte que originó la pausa, si vino de uno.
  reportId            String?
  // El dueño cerró la ventana ("Entendido" o "Editar aviso").
  ownerAcknowledgedAt DateTime?
  // Se mandó el mail al dueño.
  emailSentAt         DateTime?
  createdAt           DateTime             @default(now())
  owner               User                 @relation("ModerationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  admin               User?                @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([listingKind, listingId, createdAt])
  @@index([ownerId, ownerAcknowledgedAt])
  @@index([action, createdAt])
}

// VA-167: cada republicación de un aviso (vuelve a ponerlo primero en "Más recientes"). El saldo de Base y
// Pro sale de contar las del año en curso; "Republicar todas" (Broker y admins) deja una fila por aviso
// con bulk = true. No cambia el aviso ni su historial, solo lastPublishedAt.
model Republication {
  id          String     @id @default(cuid())
  userId      String
  aircraftId  String?
  sparePartId String?
  bulk        Boolean    @default(false)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft    Aircraft?  @relation(fields: [aircraftId], references: [id], onDelete: SetNull)
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([aircraftId])
  @@index([sparePartId])
}
